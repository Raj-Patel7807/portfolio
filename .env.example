# EmailJS Configuration (Contact Form)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Optional Admin Security Override
# Defaults to SHA-256 of "admin@raj2026" (8a21396ebaa937df6dc903e0bbd34ee5bfa780d6fce7c0c16301a24d5dc1adbc)
# You can change password inside /admin -> Settings, or set a 64-character hex hash here:
VITE_ADMIN_PASSWORD_HASH=

# Optional Cloud Storage / Supabase Sync (Zero-config localStorage is active by default)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
